# ChimeraX script: KRAS·GTP·Mg starting model with the 16 core coherent pairs
# usage: open this file in ChimeraX from the folder that holds the PDB (or edit the path)
open kras_unbound_mgwaters.pdb
set bgColor white
lighting soft
graphics silhouettes true width 1.5
cartoon style protein xsection oval width 1.6 thick 0.4
hide atoms
# base cartoon and regions
color protein #d9d9d9 target c
color :10-17 #e0b34a target c
color :30-38 #7fb069 target c
color :59-76 #a78bd0 target c
color :87-104 #b9cfe6 target c
# nucleotide and Mg2+
show :GTP,MG atoms
style :GTP stick
color :GTP #5a5a5a
color :GTP byhetero
style :MG sphere
color :MG #3cb371
# core residues (side chains; Cα sphere for glycines). Order: chi, SASA, then H-bond (residues in both SASA and H-bond pairs end H-bond coloured)
show :1,3,52,54,126,128,132 & sidechain atoms
color :1,3,52,54,126,128,132 #b83b72 target a
show :8,10,16,69,75,80,88,92,93,94,102,104,133 & sidechain atoms
color :8,10,16,69,75,80,88,92,93,94,102,104,133 #2a9d8f target a
show :69,73,88,91,92,99,102,103,105,116,144,150 & sidechain atoms
color :69,73,88,91,92,99,102,103,105,116,144,150 #d08c1f target a
style protein stick
style :10,75@CA sphere
size :10,75@CA atomRadius 0.9
color :1,3,8,10,16,52,54,69,73,75,80,88,91,92,93,94,99,102,103,104,105,116,126,128,132,133,144,150 byhetero
# H-bonds of the four core H-bond pairs (drawn from the model geometry)
hbonds :102 restrict :69,99 color #d08c1f radius 0.08 dashes 6 name hb_core
hbonds :73 restrict :103,105 color #d08c1f radius 0.08 dashes 6 name hb_core2
hbonds :88 restrict :91,92 color #d08c1f radius 0.08 dashes 6 name hb_core3
hbonds :144 restrict :116,150 color #d08c1f radius 0.08 dashes 6 name hb_core4
# labels
label :1,3,8,10,16,52,54,69,73,75,80,88,91,92,93,94,99,102,103,104,105,116,126,128,132,133,144,150 text "{0.label_one_letter_code}{0.number}" height 0.9 color black bgColor none
# view on the Switch II–α3 interface; adjust with the mouse, then save
view :59-76,87-105
# save kras_core_structure.png width 3000 supersample 3 transparentBackground true
